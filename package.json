{
  "name": "@arcanemachine/pi-session-snapshot",
  "version": "0.1.6",
  "description": "Save and restore reusable snapshots of the active Pi session path",
  "type": "module",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "session",
    "snapshot"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/arcanemachine/pi-session-snapshot/main/logo.jpg"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" package.json README.md AGENTS.md CHANGELOG.md LICENSE.md tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" package.json README.md AGENTS.md CHANGELOG.md LICENSE.md tsconfig.json",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "author": "Nicholas Moen",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "^25.3.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "logo.jpg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcanemachine/pi-session-snapshot.git"
  },
  "homepage": "https://github.com/arcanemachine/pi-session-snapshot#readme",
  "bugs": {
    "url": "https://github.com/arcanemachine/pi-session-snapshot/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
